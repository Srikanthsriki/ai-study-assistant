# ================================
# AI Study Assistant - Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file to GitHub.
# ================================

# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite for development. Change to a postgres:// URL in production.
DATABASE_URL=sqlite:///./study_assistant.db

# Used to sign JWT auth tokens. Change this to a long random string.
SECRET_KEY=change_this_secret_to_something_random_and_long

# JWT token settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Comma-separated list of allowed frontend origins (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Max upload size in MB
MAX_UPLOAD_MB=10
